# Copy to .env for local development. `.env` is gitignored; this file is committed as the
# onboarding reference (§19).
#
# Every setting is documented in app/config.py, which is the single source of truth: nothing in the
# application reads os.environ directly. In staging and production these values arrive as ECS task
# definition secrets sourced from Secrets Manager, never from a file.

# ------------------------------------------------------------------ environment
AUTHFORGE_ENVIRONMENT=local
AUTHFORGE_LOG_LEVEL=INFO

# The `iss` claim and the base for every URL in the discovery document, so it must be the origin
# clients and browsers actually reach. Deployed environments are required to use https.
AUTHFORGE_ISSUER=http://localhost:8000

# ------------------------------------------------------------------ datastores
AUTHFORGE_DATABASE_URL=postgresql+asyncpg://authforge:authforge@localhost:5432/authforge
AUTHFORGE_REDIS_URL=redis://localhost:6379/0

# Sized so N concurrent requests each hold one connection with headroom to spare. Keep
# (pool_size + max_overflow) x task_count below the RDS instance's max_connections.
AUTHFORGE_DATABASE_POOL_SIZE=5
AUTHFORGE_DATABASE_MAX_OVERFLOW=5

# ------------------------------------------------------------------ token policy
# Short access tokens are what make stateless verification acceptable: revocation is bounded by
# expiry, so the exposure window for a stolen token is minutes rather than days.
AUTHFORGE_ACCESS_TOKEN_TTL_SECONDS=600
AUTHFORGE_ID_TOKEN_TTL_SECONDS=600

# Absolute family lifetime (docs/adr/0003): a rotated refresh token inherits this expiry rather than
# extending it, bounding the compromise window regardless of how often the client refreshes.
AUTHFORGE_REFRESH_TOKEN_TTL_SECONDS=2592000

# Long enough for a redirect and a token exchange, short enough that a leaked code from a browser
# history or a proxy log is already dead.
AUTHFORGE_AUTHORIZATION_CODE_TTL_SECONDS=90

# Must be at least 2x the access token TTL, so a token signed moments before a rotation cannot
# outlive its key's presence in JWKS. Enforced at startup.
AUTHFORGE_KEY_ROTATION_GRACE_SECONDS=3600

# How long a task caches key metadata, which is also how long a rotation takes to propagate across
# the fleet without a redeploy.
AUTHFORGE_JWKS_CACHE_SECONDS=30

# Extra `aud` values placed in access tokens alongside the issuer, so a resource server can reject
# tokens minted for a different API. JSON array.
AUTHFORGE_ACCESS_TOKEN_AUDIENCES=["authforge-demo-api"]

# ------------------------------------------------------------------ sessions
AUTHFORGE_SESSION_TTL_SECONDS=43200
AUTHFORGE_PENDING_MFA_TTL_SECONDS=300
# Only false for local http development; deployed environments refuse to boot with this off.
AUTHFORGE_SESSION_COOKIE_SECURE=false
# Lax rather than Strict: the browser arrives at /authorize through a cross-site top-level redirect
# from the relying party, and Strict would withhold the session cookie on exactly that navigation.
AUTHFORGE_SESSION_COOKIE_SAMESITE=lax

# ------------------------------------------------------------------ rate limiting
AUTHFORGE_LOGIN_RATE_LIMIT_PER_IP=30
AUTHFORGE_LOGIN_RATE_LIMIT_PER_ACCOUNT=10
AUTHFORGE_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
AUTHFORGE_ACCOUNT_LOCKOUT_THRESHOLD=10
AUTHFORGE_ACCOUNT_LOCKOUT_SECONDS=900
# Fail-open by default (docs/adr/0005): a Redis outage must not lock every user out, and the controls
# that actually stop credential stuffing — Argon2id plus the durable lockout counter in Postgres —
# do not depend on Redis.
AUTHFORGE_RATE_LIMIT_FAIL_OPEN=true

# ------------------------------------------------------------------ crypto
# `local` writes PEM keys to a gitignored directory and is refused in deployed environments;
# `aws_secrets_manager` is required there.
AUTHFORGE_SIGNING_KEY_PROVIDER=local
AUTHFORGE_LOCAL_KEY_DIRECTORY=dev-keys

# Encrypts TOTP secrets at rest (AES-256-GCM via HKDF). Must be a 32-byte random value in any
# deployed environment; startup refuses the development default. Rotating it invalidates every
# enrolled second factor, so treat it as permanent.
AUTHFORGE_TOTP_ENCRYPTION_KEY=local-development-only-totp-key-0123456789

# Bearer token for the minimal admin API. Leave unset to disable that surface entirely and use the
# CLI only, which is the intended path.
AUTHFORGE_ADMIN_API_TOKEN=local-development-admin-token

# ------------------------------------------------------------------ password policy
# Raise the cost as hardware allows; existing hashes are upgraded opportunistically on next login.
AUTHFORGE_ARGON2_TIME_COST=3
AUTHFORGE_ARGON2_MEMORY_COST_KIB=65536
AUTHFORGE_ARGON2_PARALLELISM=4
AUTHFORGE_PASSWORD_MIN_LENGTH=12

# ------------------------------------------------------------------ demo apps
AUTHFORGE_DEMO_ISSUER=http://localhost:8000
AUTHFORGE_DEMO_CLIENT_ID=demo-web-client
# Printed once by `make seed`; only its hash is stored, so a lost secret must be rotated.
AUTHFORGE_DEMO_CLIENT_SECRET=
AUTHFORGE_DEMO_API_AUDIENCE=authforge-demo-api
